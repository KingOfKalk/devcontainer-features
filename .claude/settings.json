{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(gh repo create *--public*)",
      "Bash(gh repo create *--internal*)",
      "Bash(gh repo edit *--visibility*)",
      "Bash(gh repo fork *)",
      "Bash(gh repo delete *)",
      "Bash(gh gist *)",
      "Bash(gh api *gists*)",
      "Bash(gh auth token *)",
      "Read(~/.config/gh/hosts.yml)"
    ],
    "ask": [
      "Bash(gh repo create *)"
    ]
  }
}
