{
  "name": "devcontainers-features-development",
  "image": "mcr.microsoft.com/devcontainers/base:2.2.5-trixie",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
      "moby": "false"
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {
      "version": "2.103.3"
    },
    "ghcr.io/devcontainers-extra/features/devcontainers-cli:1.0.1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "esbenp.prettier-vscode",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "chat.agent.enabled": false,
        "editor.formatOnSave": true,
        "git.openRepositoryInParentFolders": "always",
        "telemetry.telemetryLevel": "off",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "zsh",
            "icon": "terminal"
          }
        }
      }
    }
  }
}
