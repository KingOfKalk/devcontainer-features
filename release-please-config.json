{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": true,
  "separate-pull-requests": true,
  "packages": {
    "src/lightpanda": {
      "component": "lightpanda",
      "extra-files": [
        {
          "type": "json",
          "path": "devcontainer-feature.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "src/fastcrw": {
      "component": "fastcrw",
      "extra-files": [
        {
          "type": "json",
          "path": "devcontainer-feature.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "src/home-persistence": {
      "component": "home-persistence",
      "extra-files": [
        {
          "type": "json",
          "path": "devcontainer-feature.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "src/openshell": {
      "component": "openshell",
      "extra-files": [
        {
          "type": "json",
          "path": "devcontainer-feature.json",
          "jsonpath": "$.version"
        }
      ]
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "refactor",
      "section": "Code Refactoring",
      "hidden": true
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Styles",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build System",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Continuous Integration",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    }
  ]
}
